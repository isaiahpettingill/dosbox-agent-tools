@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\DCMATRIX\NUL MD C:\APPS\DCMATRIX
COPY A:\*.* C:\APPS\DCMATRIX >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\DCMATRIX.BAT
ECHO C:\APPS\DCMATRIX\DCMATRIX.COM %%1 %%2 %%3 %%4 %%5 %%6 %%7 %%8 %%9 >> C:\SYSTEM\DCMATRIX.BAT
ECHO DCMATRIX installed. Run DCMATRIX.
