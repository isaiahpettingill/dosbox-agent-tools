@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\DWED\NUL MD C:\APPS\DWED
COPY A:\*.* C:\APPS\DWED >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\DWED.BAT
ECHO C:\APPS\DWED\DWED.EXE %%1 %%2 %%3 %%4 %%5 %%6 %%7 %%8 %%9 >> C:\SYSTEM\DWED.BAT
ECHO DWED installed. Run DWED.
