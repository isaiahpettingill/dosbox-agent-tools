@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\TDE\NUL MD C:\APPS\TDE
COPY A:\*.* C:\APPS\TDE >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\TDE.BAT
