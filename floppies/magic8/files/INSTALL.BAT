@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\MAGIC8\NUL MD C:\APPS\MAGIC8
COPY A:\*.* C:\APPS\MAGIC8 >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\MAGIC8.BAT
