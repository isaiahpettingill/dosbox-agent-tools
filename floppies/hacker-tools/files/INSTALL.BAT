@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\HACKTOOLS\NUL MD C:\APPS\HACKTOOLS
COPY A:\*.* C:\APPS\HACKTOOLS >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\HACKTOOLS.BAT
ECHO PATH C:\APPS\HACKTOOLS;%%PATH%% >> C:\SYSTEM\HACKTOOLS.BAT
ECHO Hacker Tools installed. Run HACKTOOLS then use STRINGS, DISASM, SERMON, PATCH, or ASMLITE.
