@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\EDIT\NUL MD C:\APPS\EDIT
COPY A:\*.* C:\APPS\EDIT >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\EDIT.BAT
