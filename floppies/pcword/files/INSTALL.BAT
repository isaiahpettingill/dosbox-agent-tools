@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\PCWORD\NUL MD C:\APPS\PCWORD
IF NOT EXIST C:\APPS\PCWORD\DRIVERS\NUL MD C:\APPS\PCWORD\DRIVERS
IF NOT EXIST C:\APPS\PCWORD\MANUALS\NUL MD C:\APPS\PCWORD\MANUALS
COPY A:\RSORT.COM C:\APPS\PCWORD >NUL
COPY A:\PCWORD.LSM C:\APPS\PCWORD >NUL
COPY A:\INSTALL.BAT C:\APPS\PCWORD >NUL
COPY A:\PCWORD\*.* C:\APPS\PCWORD >NUL
COPY A:\PCWORD\DRIVERS\*.* C:\APPS\PCWORD\DRIVERS >NUL
COPY A:\PCWORD\MANUALS\*.* C:\APPS\PCWORD\MANUALS >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\PCWORD.BAT
ECHO C: >> C:\SYSTEM\PCWORD.BAT
ECHO CD \APPS\PCWORD >> C:\SYSTEM\PCWORD.BAT
ECHO PCWORD.EXE /C PCWORD.CFG %%1 %%2 %%3 %%4 %%5 %%6 %%7 %%8 %%9 >> C:\SYSTEM\PCWORD.BAT
ECHO @ECHO OFF > C:\SYSTEM\RSORT.BAT
ECHO C:\APPS\PCWORD\RSORT.COM %%1 %%2 %%3 %%4 %%5 %%6 %%7 %%8 %%9 >> C:\SYSTEM\RSORT.BAT
ECHO PCWORD installed. Run PCWORD.
