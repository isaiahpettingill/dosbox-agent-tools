@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\GWBASIC\NUL MD C:\APPS\GWBASIC
COPY A:\*.* C:\APPS\GWBASIC >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\GWBASIC.BAT
ECHO C:\APPS\GWBASIC\GWBASIC.EXE %%1 %%2 %%3 %%4 %%5 %%6 %%7 %%8 %%9 >> C:\SYSTEM\GWBASIC.BAT
ECHO @ECHO OFF > C:\SYSTEM\GWBASICA.BAT
ECHO C:\APPS\GWBASIC\GWBASICA.EXE %%1 %%2 %%3 %%4 %%5 %%6 %%7 %%8 %%9 >> C:\SYSTEM\GWBASICA.BAT
ECHO GWBASIC installed. Run GWBASIC.
