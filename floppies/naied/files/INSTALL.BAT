@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\NAIED\NUL MD C:\APPS\NAIED
COPY A:\*.* C:\APPS\NAIED >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\NAIED.BAT
ECHO C:\APPS\NAIED\NAIED.EXE %%1 %%2 %%3 %%4 %%5 %%6 %%7 %%8 %%9 >> C:\SYSTEM\NAIED.BAT
ECHO NAIED installed. Run NAIED.
