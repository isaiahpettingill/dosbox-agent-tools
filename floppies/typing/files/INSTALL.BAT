@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\TYPEFURY\NUL MD C:\APPS\TYPEFURY
COPY A:\*.* C:\APPS\TYPEFURY >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\TYPEFURY.BAT
ECHO C:\APPS\TYPEFURY\TYPEFURY.EXE %%1 %%2 %%3 %%4 %%5 %%6 %%7 %%8 %%9 >> C:\SYSTEM\TYPEFURY.BAT
ECHO TYPEFURY installed. Run TYPEFURY.
