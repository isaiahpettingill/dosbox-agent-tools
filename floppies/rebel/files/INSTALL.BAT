@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\REBEL\NUL MD C:\APPS\REBEL
COPY A:\REBEL.LSM C:\APPS\REBEL >NUL
COPY A:\INSTALL.BAT C:\APPS\REBEL >NUL
COPY A:\REBEL\*.* C:\APPS\REBEL >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\REBEL.BAT
ECHO C: >> C:\SYSTEM\REBEL.BAT
ECHO CD \APPS\REBEL >> C:\SYSTEM\REBEL.BAT
ECHO REBEL.EXE %%1 %%2 %%3 %%4 %%5 %%6 %%7 %%8 %%9 >> C:\SYSTEM\REBEL.BAT
ECHO REBEL installed. Run REBEL.
