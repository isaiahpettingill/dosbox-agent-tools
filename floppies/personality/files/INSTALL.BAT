@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\IPIPTEST\NUL MD C:\APPS\IPIPTEST
COPY A:\*.* C:\APPS\IPIPTEST >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\IPIPTEST.BAT
ECHO C:\APPS\IPIPTEST\IPIPTEST.EXE %%1 %%2 %%3 %%4 %%5 %%6 %%7 %%8 %%9 >> C:\SYSTEM\IPIPTEST.BAT
ECHO IPIPTEST installed. Run IPIPTEST.
