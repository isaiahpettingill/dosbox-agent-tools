@ECHO OFF
IF NOT EXIST C:\APPS\NUL MD C:\APPS
IF NOT EXIST C:\APPS\HELLO\NUL MD C:\APPS\HELLO
COPY A:\*.* C:\APPS\HELLO >NUL
IF NOT EXIST C:\SYSTEM\NUL MD C:\SYSTEM
ECHO @ECHO OFF > C:\SYSTEM\HELLO.BAT
ECHO C:\APPS\HELLO\HELLO.EXE %%1 %%2 %%3 %%4 %%5 %%6 %%7 %%8 %%9 >> C:\SYSTEM\HELLO.BAT
ECHO HELLO installed. Run HELLO.
